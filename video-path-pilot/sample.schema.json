{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parsewave.example/schemas/edit-path-sample-0.1.0.json",
  "title": "Edit-path training sample MVP",
  "type": "object",
  "required": ["schema_version", "sample_id", "task", "project", "inputs", "edit_path", "output", "quality", "evidence", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "sample_id": {"type": "string", "minLength": 1},
    "task": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "required": ["frame_rate", "width", "height"],
      "properties": {
        "frame_rate": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "inputs": {
      "type": "object",
      "required": ["assets"],
      "properties": {
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["asset_id", "file", "sha256", "bytes"],
            "properties": {
              "asset_id": {"type": "string"},
              "file": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "edit_path": {
      "type": "object",
      "required": ["time_unit", "operations"],
      "properties": {
        "time_unit": {"const": "frame"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["operation_id", "operation", "changes", "resulting_state_hash"],
            "properties": {
              "operation_id": {"type": "string"},
              "operation": {"type": "string"},
              "changes": {"type": "array", "minItems": 1},
              "resulting_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["video", "sha256"],
      "properties": {
        "video": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "additionalProperties": true
}
