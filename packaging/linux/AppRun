#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Never trust an inherited APPDIR. Diagnostic/extracted runs may leave it set
# to an older AppImage, causing EditPath to launch a Kdenlive path that no
# longer exists.
APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
export EDIT_PATH_REPO_ROOT="$APPDIR/usr"
export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export QML2_IMPORT_PATH="$APPDIR/usr/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export QML_IMPORT_PATH="$APPDIR/usr/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export MLT_PREFIX="$APPDIR/usr"
export MLT_DATA="$APPDIR/usr/share/mlt-7"
export MLT_REPOSITORY="$APPDIR/usr/lib/mlt-7"
export FREI0R_PATH="$APPDIR/usr/lib/frei0r-1"
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr${PYTHONPATH:+:$PYTHONPATH}"
exec "$APPDIR/usr/bin/EditPath" "$@"
