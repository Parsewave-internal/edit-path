# The digest and package NEVRAs are intentionally explicit. Rebuild this image
# only as a reviewed renderer upgrade, then capture its image digest alongside
# the runtime lock generated by `edit-path lock-runtime`.
FROM opensuse/tumbleweed@sha256:18a8c2a41252a0100ae4a7dae0a0e925fb522971645b97b05c57f9b6e73c3b4f

RUN zypper --non-interactive install --no-recommends \
        melt=7.38.0-2.2 \
        ffmpeg-8=8.1.2-1.2 \
        python313=3.13.13-3.2 \
        python313-zstandard=0.25.0-1.5 \
        dejavu-fonts=2.37-2.3 \
        liberation-fonts=2.1.5-1.12 \
    && zypper clean --all

COPY pyproject.toml /opt/edit-path/pyproject.toml
COPY edit_path /opt/edit-path/edit_path
ENV PYTHONPATH=/opt/edit-path
WORKDIR /data
ENTRYPOINT ["python3", "-m", "edit_path"]
